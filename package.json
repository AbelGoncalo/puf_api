{
  "name": "puf_api",
  "version": "0.0.0",
  "main": "index.js",
  "repository": "git@github.com:AbelGoncalo/puf_api.git",
  "author": {
    "name": "Abel Goncalo",
    "email": "abelgoncalo8@gmail.com"
  },
  "license": "MIT",
  "private": false,
  "scripts": {
    "fix": "run-s \"fix:* {@}\" --",
    "fix:lint": "eslint --fix --no-error-on-unmatched-pattern",
    "fix:format": "prettier --write",
    "format": "yarn fix:format src/**/*.{js,ts,md,json}",
    "lint": "yarn fix:lint src/**/*.{js,ts,md,json}",
    "prebuild": "rimraf ./dist",
    "build": "babel src --extensions \".js\" --ignore \"*.spec.js,*.test.js\" --out-dir dist --copy-files",
    "dev": "nodemon --exec  babel-node -- -r dotenv-safe/config src/index.js"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "./src/**/*.{js,md,json}": [
      "yarn fix"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.27.0",
    "@babel/core": "^7.26.10",
    "@babel/node": "^7.26.0",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/preset-env": "^7.26.9",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-prettier": "^5.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "nodemon": "^3.1.9",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1"
  },
  "dependencies": {
    "@koa/router": "^13.1.0",
    "dotenv": "^16.5.0",
    "dotenv-safe": "^9.1.0",
    "koa": "^2.16.1",
    "koa-bodyparser": "^4.4.1",
    "npm-run-all": "^4.1.5"
  }
}
