{
  "name": "puf_api",
  "version": "0.0.0",
  "main": "index.js",
  "repository": "git@github.com:AbelGoncalo/puf_api.git",
  "author": {
    "name": "Abel Goncalo",
    "email": "abelgoncalo8@gmail.com"
  },
  "license": "MIT",
  "private": false,
  "scripts": {
    "fix": "run-s \"fix:* {@}\" --",
    "fix:lint": "eslint --fix --no-error-on-unmatched-pattern",
    "fix:format": "prettier --write",
    "format": "yarn fix:format src/**/*.{js,ts,md,json}",
    "lint": "yarn fix:lint src/**/*.{js,ts,md,json}"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "lint-staged": {
    "./src/**/*.{js,md,json}": [
      "yarn fix"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-prettier": "^5.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "prettier": "^3.5.3"
  },
  "dependencies": {
    "npm-run-all": "^4.1.5"
  }
}
