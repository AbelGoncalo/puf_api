{
  "extends":[
    "eslint:recommended",
    "plugin:json/recommended",
    "plugin:prettier/recommended"
  ],
  "env":{
    "es6": true,
    "node": true,
    "jest": true
  },
  "rules":{
    "comma-dangle":[
      "error",
      {
        "arrays":"always-multline",
        "objecst":"always-multline",
        "imports":"always-multline",
        "exports":"always-multline",
        "functions":"never"

      }
    ]
  },
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module"
  }
}
